# Exemplo de .env — substitua pelos seus valores reais
# Obtenha a URI no MongoDB Atlas: Connect -> Connect your application
# Substitua <usuario>, <senha>, <cluster>, <nome_do_banco>
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<nome_do_banco>?retryWrites=true&w=majority

# Chave secreta para o Flask (troque por uma string aleatória no seu ambiente)
SECRET_KEY=troque_por_uma_chave_super_secreta

# Opcional: ambiente do Flask (development, production)
FLASK_ENV=development